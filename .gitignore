/.env
/.idea
/vendor
.DS_Store
node_modules

/craft/vendor
/craft/.env

/.config

# BUILD
# package-lock.json is COMMITTED here, unlike the other sites. Those build
# locally; this one builds on the server, where Forge's npm step runs `npm ci`
# — which fails outright without a lockfile. Committed, the server installs the
# exact versions of Vite and its plugins that the site was built against.
/public/dist/*
.tpl

# Designer mockup tool — kept locally, never committed
vsp.html

# Local DB backups (created by pull_db_production_to_local.sh)
/.backups

# ---------------------------------------------------------------------------
# ADDED FOR THIS SITE — three things the usual list doesn't cover, because this
# project has them and the old one didn't.
# ---------------------------------------------------------------------------

# CRAFT RUNTIME — logs, caches, compiled templates, DB backups. 224MB.
#
# The size is the smaller reason. storage/logs/phperrors.log dumps the ENTIRE
# environment on a fatal error — Anthropic key, Spotify secrets, DB password —
# so committing this directory would publish exactly what /craft/.env above is
# there to keep out. Craft rebuilds all of it on demand; none of it is source.
/craft/storage/*
!/craft/storage/.gitkeep

# CONTROL PANEL ASSETS — 54MB Craft republishes itself on demand.
/public/cpresources/*
!/public/cpresources/.gitkeep

# UPLOADED ASSETS — 292MB of photography. Content, not code.
#
# They arrive through the control panel, and on Forge they live in a `shared/`
# directory symlinked into each release, which is what lets generated image
# transforms survive a deploy. In git they'd be a second system of record and a
# 300MB clone.
#
# CONSEQUENCE: a fresh server starts with no images. Copy them up once with
# rsync, into the shared directory — not through a deploy.
/public/assets

# DDEV — local database credentials, machine-specific.
/.ddev/.env.web
