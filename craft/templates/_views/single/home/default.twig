{# This template extends...#}
{% extends '_layouts/page.twig' %}

{% set tplPath = _self %}

{# The ask bar's prompt, with the visitor's name in it when they came through a VIP
   door: "Ask me anything, Lee...". vip.personalise() returns the line untouched when
   there is no VIP and no first name, so both bars below can use it blind.

   Set once here rather than called twice: the two bars are the same invitation in two
   places (the front door, and the thread's own bar once a conversation is running) and
   they must not drift apart.

   Safe to personalise because this page is never cached for anyone else — HTML goes out
   `no-cache, no-store` and Cloudflare reports it DYNAMIC. The VIP strip in the layout
   already relies on that.

   The LABEL keeps no ellipsis: it is read aloud, where trailing dots are noise rather
   than an invitation. #}
{# The wording itself is the Globals single's jonsonPlaceholderDefault, falling back to
   the line this always said when the field is empty; the label is the same words with
   any trailing ellipsis taken off. Same source as _components/ask.twig. #}
{% set jonson = craft.app.getModule('jonson') %}
{% set globals = craft.entries().section('globals').one() %}
{% set placeholderLine = (globals ? (globals.jonsonPlaceholderDefault ?? '')|trim : '') ?: 'Ask me anything...' %}
{% set askPlaceholder = jonson.vip.personalise(placeholderLine) %}
{% set askLabel = jonson.vip.personalise(placeholderLine|replace('/(\\.{3}|…)$/u', '')|trim) %}

{# Which backdrop the hero section draws behind the title and ask bar.

   'hero'   the Record3D point cloud (build/js/components/hero.js + the baked
            hero.bin), loaded on demand because it pulls in three.
   'tunnel' the original canvas dot tunnel (build/js/components/tunnel.js).

   The tunnel is kept in full — markup, JS and styles — so flipping this back is a
   one-word change rather than a rebuild. Everything around the backdrop (the
   section, the h1, the form, the warp into Jonson) is shared by both. #}
{% set backdrop = 'hero' %}

{% block siteContent %}
<section class="c-frontdoor" data-frontdoor>
    <div class="c-frontdoor__bg">
        {% if backdrop == 'hero' %}
            {# No src here — hero.js imports the binary as a bundled asset, so the
               built filename carries a content hash and the path stays out of the
               markup. See the import at the top of that file. #}
            <div class="c-hero" data-hero></div>
        {% else %}
            <canvas data-tunnel-canvas></canvas>
        {% endif %}
    </div>
    <div class="c-frontdoor__meta">
        {# `longTitle`, like every other section — but NOT the usual `?: entry.title`
           fallback. This single's title is "Home", which is a CMS label, not a
           headline; falling back to it would put "Home" in the hero. #}
        <h1 class="c-frontdoor__title">{{ entry.longTitle ?: 'Ask me anything' }}</h1>
        {# The default prompts for this visitor (jonson.vip.prompts(): their VIP entry's
           own, else their door's purpose set, else the Globals `prompts`), cycled through the field's
           placeholder by placeholder-cycle.js as `Ask "…"` — here and in the thread's
           own bar below. The real placeholder attribute is the first of them in the same
           shape, so the field opens on what the script starts on and reads the same
           without JS. With no prompts it falls back to the opening line. #}
        {% set prompts = jonson.vip.prompts() %}
        {% set fieldPlaceholder = prompts|length ? 'Ask "' ~ prompts|first ~ '"' : askPlaceholder %}
        <div class="c-frontdoor__field">
        <form
            class="c-frontdoor__form"
            method="post"
            data-jonson-form
            data-endpoint="{{ siteUrl('jonson/ask') }}"
        >
            {{ csrfInput() }}
            <span class="c-field__wrap">
            <input
                class="c-frontdoor__input"
                type="text"
                name="question"
                placeholder="{{ fieldPlaceholder }}"
                aria-label="{{ askLabel }}"
                {# Matches AskController::MAX_QUESTION_CHARS. A courtesy, not a control —
                   the server truncates regardless, since anything can post to the
                   endpoint. This just stops an honest paste being silently cut later. #}
                maxlength="1000"
                autocomplete="off"
                data-jonson-input
                {%- if prompts|length %} data-placeholder-cycle='{{ prompts|values|json_encode|raw }}'{% endif %}
            >
            </span>
            {# Always on: an empty field still has something to send — the prompt the
               placeholder is showing. #}
            <button class="c-frontdoor__submit" type="submit" aria-label="Submit">
                <svg class="c-frontdoor__submit-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M9 4.5a.75.75 0 0 1 .721.544l.813 2.846a3.75 3.75 0 0 0 2.576 2.576l2.846.813a.75.75 0 0 1 0 1.442l-2.846.813a3.75 3.75 0 0 0-2.576 2.576l-.813 2.846a.75.75 0 0 1-1.442 0l-.813-2.846a3.75 3.75 0 0 0-2.576-2.576l-2.846-.813a.75.75 0 0 1 0-1.442l2.846-.813A3.75 3.75 0 0 0 7.466 7.89l.813-2.846A.75.75 0 0 1 9 4.5ZM18 1.5a.75.75 0 0 1 .728.568l.258 1.036c.236.94.97 1.674 1.91 1.91l1.036.258a.75.75 0 0 1 0 1.456l-1.036.258c-.94.236-1.674.97-1.91 1.91l-.258 1.036a.75.75 0 0 1-1.456 0l-.258-1.036a2.625 2.625 0 0 0-1.91-1.91l-1.036-.258a.75.75 0 0 1 0-1.456l1.036-.258a2.625 2.625 0 0 0 1.91-1.91l.258-1.036A.75.75 0 0 1 18 1.5ZM16.5 15a.75.75 0 0 1 .712.513l.394 1.183c.15.447.5.799.948.948l1.183.395a.75.75 0 0 1 0 1.422l-1.183.395c-.447.15-.799.5-.948.948l-.395 1.183a.75.75 0 0 1-1.422 0l-.395-1.183a1.5 1.5 0 0 0-.948-.948l-1.183-.395a.75.75 0 0 1 0-1.422l1.183-.395c.447-.15.799-.5.948-.948l.395-1.183A.75.75 0 0 1 16.5 15Z"/>
                </svg>
            </button>
        </form>
        </div>
    </div>
</section>

{# The URLs Jonson is allowed to turn into links inside its prose — this visitor's
   own routes, from the CTAs their VIP door unlocked (craft.frontend.doorCtas()).

   WHY THE PAGE CARRIES THEM. inlineMarkdown() lets tel:, mailto: and same-site paths
   through on their own, because those cannot point anywhere but at Jon. An https: URL
   can point anywhere, so it is allowed only by EXACT MATCH against this list: a link
   the model writes is either one the CMS already holds for this visitor, or it is not
   a link at all. That keeps "the model decides where, code decides what" true of links
   as it is of every other surface — and it means a URL Jonson invents cannot render,
   however plausible it looks.

   Space-separated: none of these can contain a space (safeUrl strips the invisible
   characters that would survive one). Empty for anyone without a door. #}
{% set jonsonLinks = craft.frontend.doorCtas()|map(c => craft.frontend.safeUrl(c.ctaUrl.url ?? null))|filter(u => u) %}

{# Conversation view — revealed in-place on the first question. #}
<section class="c-jonson" data-jonson-view hidden
    {%- if jonsonLinks|length %} data-jonson-links="{{ jonsonLinks|join(' ') }}"{% endif %}>
    <p class="c-jonson__whisper u-font-whisper">Ask me anything</p>

    <div class="c-jonson__thread" data-jonson-thread></div>

    <footer class="c-jonson__footer">
        {# Deliberate reset — same meaning as the logo, so same marker. #}
        <a class="c-jonson__home" href="{{ siteUrl('') }}" aria-label="Start over" data-wipe-thread>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M11.47 3.841a.75.75 0 0 1 1.06 0l8.69 8.69a.75.75 0 1 0 1.06-1.061l-8.689-8.69a2.25 2.25 0 0 0-3.182 0l-8.69 8.69a.75.75 0 1 0 1.061 1.06l8.69-8.689Z"/>
                <path d="m12 5.432 8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 0 1-.75-.75v-4.5a.75.75 0 0 0-.75-.75h-3a.75.75 0 0 0-.75.75V21a.75.75 0 0 1-.75.75H5.625a1.875 1.875 0 0 1-1.875-1.875v-6.198a2.29 2.29 0 0 0 .091-.086L12 5.432Z"/>
            </svg>
        </a>
        <form
            class="c-jonson__form"
            method="post"
            data-jonson-followup
            data-endpoint="{{ siteUrl('jonson/ask') }}"
        >
            {{ csrfInput() }}
            <span class="c-field__wrap">
            <input
                class="c-jonson__input"
                type="text"
                name="question"
                placeholder="{{ fieldPlaceholder }}"
                {# No ellipsis on the label — it's read aloud, where trailing dots are
                   noise rather than an invitation. #}
                aria-label="{{ askLabel }}"
                {# Matches AskController::MAX_QUESTION_CHARS. A courtesy, not a control —
                   the server truncates regardless, since anything can post to the
                   endpoint. This just stops an honest paste being silently cut later. #}
                maxlength="1000"
                autocomplete="off"
                {%- if prompts|length %} data-placeholder-cycle='{{ prompts|values|json_encode|raw }}'{% endif %}
            >
            </span>
            <button class="c-jonson__submit" type="submit" aria-label="Submit">
                {# Sparkles, not an arrow — same icon as the ask bar's submit (_components/ask). #}
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M9 4.5a.75.75 0 0 1 .721.544l.813 2.846a3.75 3.75 0 0 0 2.576 2.576l2.846.813a.75.75 0 0 1 0 1.442l-2.846.813a3.75 3.75 0 0 0-2.576 2.576l-.813 2.846a.75.75 0 0 1-1.442 0l-.813-2.846a3.75 3.75 0 0 0-2.576-2.576l-2.846-.813a.75.75 0 0 1 0-1.442l2.846-.813A3.75 3.75 0 0 0 7.466 7.89l.813-2.846A.75.75 0 0 1 9 4.5ZM18 1.5a.75.75 0 0 1 .728.568l.258 1.036c.236.94.97 1.674 1.91 1.91l1.036.258a.75.75 0 0 1 0 1.456l-1.036.258c-.94.236-1.674.97-1.91 1.91l-.258 1.036a.75.75 0 0 1-1.456 0l-.258-1.036a2.625 2.625 0 0 0-1.91-1.91l-1.036-.258a.75.75 0 0 1 0-1.456l1.036-.258a2.625 2.625 0 0 0 1.91-1.91l.258-1.036A.75.75 0 0 1 18 1.5ZM16.5 15a.75.75 0 0 1 .712.513l.394 1.183c.15.447.5.799.948.948l1.183.395a.75.75 0 0 1 0 1.422l-1.183.395c-.447.15-.799.5-.948.948l-.395 1.183a.75.75 0 0 1-1.422 0l-.395-1.183a1.5 1.5 0 0 0-.948-.948l-1.183-.395a.75.75 0 0 1 0-1.422l1.183-.395c.447-.15.799-.5.948-.948l.395-1.183A.75.75 0 0 1 16.5 15Z"/>
                </svg>
            </button>
        </form>
    </footer>
</section>
{% endblock %}