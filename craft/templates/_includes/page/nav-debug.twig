{#
  TEMPORARY — nav-open header jump in LinkedIn's iPhone in-app browser (2026-09-30).
  Only with ?navdebug in the URL. Prints what the header is measured against, closed
  and open, so the cause can be read off a screenshot. Remove once fixed.
#}
<script>
(() => {
    const box = document.createElement('pre');
    box.style.cssText = 'position:fixed;left:4px;right:4px;bottom:4px;z-index:2147483647;margin:0;padding:6px;'
        + 'background:rgba(0,0,0,.85);color:#0f0;font:10px/1.25 monospace;white-space:pre-wrap;pointer-events:none;max-height:60vh;overflow:hidden';
    document.body.appendChild(box);
    const r = (el) => {
        if (!el) return 'none';
        const b = el.getBoundingClientRect();
        return [b.left, b.top, b.width, b.height].map((n) => Math.round(n * 10) / 10).join(',');
    };
    const snap = (label) => {
        const h = document.querySelector('.b-header');
        const cs = getComputedStyle(h);
        const vv = window.visualViewport;
        const suspects = [];
        for (let el = h.parentElement; el && el !== document.documentElement.parentNode; el = el.parentElement) {
            const s = getComputedStyle(el);
            const hits = ['transform', 'filter', 'perspective', 'backdropFilter', 'willChange', 'contain', 'containerType']
                .filter((p) => s[p] && !['none', 'auto', 'normal'].includes(s[p]))
                .map((p) => `${p}=${s[p]}`);
            if (hits.length) suspects.push(`${el.tagName.toLowerCase()}.${[...el.classList].join('.')} [${r(el)}] ${hits.join(' ')}`);
        }
        return `${label}\n`
            + `inner ${innerWidth}x${innerHeight} client ${document.documentElement.clientWidth}x${document.documentElement.clientHeight} dpr ${devicePixelRatio}\n`
            + `vv ${vv ? [vv.width, vv.height, vv.offsetLeft, vv.offsetTop, vv.scale].map((n) => Math.round(n * 10) / 10).join(',') : 'n/a'} scrollY ${scrollY}\n`
            + `--nav-scrollbar "${getComputedStyle(document.documentElement).getPropertyValue('--nav-scrollbar')}"\n`
            + `header ${cs.position} top ${cs.top} left ${cs.left} right ${cs.right} pad ${cs.paddingLeft}/${cs.paddingRight} [${r(h)}]\n`
            + `logo [${r(document.querySelector('.b-logo__roundel'))}] burger [${r(document.querySelector('.b-header__burger'))}]\n`
            + `wrap [${r(document.querySelector('body > .b-wrap'))}] offsetParent ${h.offsetParent ? h.offsetParent.tagName + '.' + [...h.offsetParent.classList].join('.') : 'null'}\n`
            + `containing-block suspects:\n  ${suspects.join('\n  ') || 'none'}`;
    };
    let closed = snap('CLOSED');
    box.textContent = closed + '\n\n' + navigator.userAgent;
    // Document, capture phase: runs BEFORE the toggle's own handler flips the class.
    document.addEventListener('click', (e) => {
        if (!e.target.closest('[data-nav-toggle]')) return;
        if (document.documentElement.classList.contains('is-nav-open')) return; // about to close
        closed = snap('CLOSED');
        setTimeout(() => { box.textContent = closed + '\n\n' + snap('OPEN') + '\n\n' + navigator.userAgent; }, 900);
    }, true);
})();
</script>
