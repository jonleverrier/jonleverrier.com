{#
  A row of CTA boxes — solid cards from a `ctas` Matrix list ({ title, ctaUrl }).
  Styling takes cues from .c-jonson__suggestion (solid fill, JonSonMono, the
  pop-in arrow + spinning border on hover). See build/scss/components/_ctas.scss.
#}
{% if ctas ?? false %}
    <div class="c-ctas">
      {# The inner wrapper carries the stack; the outer one carries the panel. On the
         contact page that split is what lets the white column stay stretched to the
         form's height while the chips inside it stick — see _ctas.scss. #}
      <div class="c-ctas__inner">
        {% if heading ?? false %}
            <p class="c-ctas__whisper u-font-whisper">{{ heading }}</p>
        {% endif %}
        {% for cta in ctas %}
            {# safeUrl strips invisible Unicode — a pasted phone number brings bidi
               controls with it, which percent-encode into the href and 404 the link. #}
            {% set href = craft.frontend.safeUrl(cta.ctaUrl.url ?? null) %}
            {# The Link field's own target (Advanced → Target on the CTA). rel="noopener"
               rides along with _blank: current browsers imply it, older ones do not, and
               without it the opened page can reach back through window.opener and
               retarget the tab it came from. #}
            {% set target = cta.ctaUrl.target ?? null %}
            {# The mark before the words — which one is decided from the link itself (see
               craft.frontend.ctaIcon). An empty span painted by CSS rather than inline
               SVG, because the sprite is how every other icon on the site arrives and a
               mask takes currentColor with the label. aria-hidden: the label already
               says what this is, so a screen reader announcing it twice helps nobody. #}
            <a class="c-ctas__item"{% if href %} href="{{ href }}"{% endif %}
               {%- if target %} target="{{ target }}"{% if target == '_blank' %} rel="noopener"{% endif %}{% endif %}>
                <span class="c-ctas__icon c-ctas__icon--{{ craft.frontend.ctaIcon(cta) }}" aria-hidden="true"></span>
                <span class="c-ctas__label">{{ cta.title }}</span>
            </a>
        {% endfor %}
      </div>
    </div>
{% endif %}
