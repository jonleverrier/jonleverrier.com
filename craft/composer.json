{
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "craftcms/ckeditor": "^5.7.0",
    "craftcms/cms": "^5.11.1",
    "craftcms/postmark": "^3.1.0",
    "miranj/craft-cryptographer": "^1.2.0",
    "nystudio107/craft-vite": "^5.0.2",
    "putyourlightson/craft-cloudflare": "^3.1.3",
    "verbb/doxter": "^6.0.2",
    "verbb/expanded-singles": "^3.0.3",
    "vlucas/phpdotenv": "^5.4.0",
    "yiisoft/yii2-redis": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "modules\\": "modules/"
    }
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-update-cmd": [
      "@php craft clear-caches/all --interactive=0",
      "@php craft migrate/all --interactive=0",
      "@php craft project-config/apply"
    ],
    "post-install-cmd": [
      "@php craft clear-caches/all --interactive=0",
      "@php craft migrate/all --interactive=0",
      "@php craft project-config/apply"
    ]
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.craftcms.com",
      "canonical": false
    }
  ]
}
