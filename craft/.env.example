# Read about configuration, here:
# https://craftcms.com/docs/5.x/configure.html

# The application ID used to to uniquely store session and cache data, mutex locks, and more
CRAFT_APP_ID=CraftCMS--jonleverrier2

# The environment Craft is currently running in (dev, staging, production, etc.)
CRAFT_ENVIRONMENT=dev

# Database connection settings
CRAFT_DB_DRIVER="mysql"
CRAFT_DB_SERVER="db"
CRAFT_DB_PORT="3306"
CRAFT_DB_DATABASE="db"
CRAFT_DB_USER="db"
CRAFT_DB_PASSWORD="db"
CRAFT_DB_SCHEMA=public
CRAFT_DB_TABLE_PREFIX=

# General settings
CRAFT_SECURITY_KEY=
CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=true

# Site settings
PRIMARY_SITE_URL=https://jonleverrier2.local/
PRIMARY_SITE_WEBROOT=/var/www/html/public

# Anthropic (Jonson AI assistant)
KEY_ANTHROPIC_API=
KEY_ANTHROPIC_MODEL=claude-opus-4-8

# Redis — backs the `cache` and `session` components (see config/app.php).
# Leave REDIS_HOST empty to run on the file cache and file sessions instead.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_SESSION_DATABASE=1
